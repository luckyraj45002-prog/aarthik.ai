# ========================================================
# AARTHIK.AI PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# Supabase Auth & Cloud Database
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Upstash / Redis Configuration (Rate Limiting & Account Lockout)
# Optional: falls back gracefully to in-memory TTL cache if omitted
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# Application Base URL (Password Reset Links & Redirects)
APP_URL=https://aarthik.ai
PORT=3000
NODE_ENV=production
